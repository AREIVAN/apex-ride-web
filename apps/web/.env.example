NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mapbox configuration
# Get your token at: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token

# Base toggles (rollback inmediato)
MAPBOX_DIRECTIONS_ENABLED=true
MAPBOX_MAP_MATCHING_ENABLED=false

# Canary targeting (allowlist separada + porcentaje 0..100)
MAPBOX_DIRECTIONS_CANARY_ALLOWLIST=
MAPBOX_DIRECTIONS_CANARY_PERCENT=
MAPBOX_MAP_MATCHING_CANARY_ALLOWLIST=
MAPBOX_MAP_MATCHING_CANARY_PERCENT=
ROUTING_CANARY_SALT=
